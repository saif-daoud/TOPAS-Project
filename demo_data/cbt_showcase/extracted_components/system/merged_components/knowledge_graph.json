{
  "nodes": [
    {
      "type": "Patient",
      "description": "Root node representing the individual receiving cognitive behavioral therapy."
    },
    {
      "type": "Demographics",
      "description": "Patient’s age, gender, cultural background, education, vocation, and social context."
    },
    {
      "type": "Presenting Problems",
      "description": "Presenting complaints, symptom descriptions, and contextual/problem history."
    },
    {
      "type": "Diagnosis/Clinical History",
      "description": "Mental and physical health diagnoses, comorbidities, and longitudinal symptom profiles."
    },
    {
      "type": "Medical History",
      "description": "Relevant medical background, medication adherence, and physical health/disability details."
    },
    {
      "type": "Family Psychiatric and Medical History",
      "description": "Family history of psychiatric, medical, and substance issues impacting the patient."
    },
    {
      "type": "Developmental and Life Events",
      "description": "Developmental, childhood, family, social, educational, and critical life events or trauma."
    },
    {
      "type": "Cultural/Contextual Factors",
      "description": "Cultural, familial, religious, language, and developmental influences relevant to therapy."
    },
    {
      "type": "Core Beliefs/Schemas",
      "description": "Enduring beliefs and schemas about self, others, world; developmental origins and conviction strength."
    },
    {
      "type": "Intermediate Beliefs/Assumptions",
      "description": "Attitudes, rules, conditional assumptions derived from core beliefs."
    },
    {
      "type": "Automatic Thoughts",
      "description": "Recurring spontaneous cognitions or negative automatic thoughts and their context and impact."
    },
    {
      "type": "Cognitive Distortions",
      "description": "Unhelpful thinking styles, biases, and patterns across time."
    },
    {
      "type": "Behavioral Patterns",
      "description": "Adaptive and maladaptive patterns including avoidance, approach, rituals, withdrawal, and safety behaviors."
    },
    {
      "type": "Coping Strategies",
      "description": "Adaptive and maladaptive strategies used by the patient for regulation and distress management."
    },
    {
      "type": "Strengths and Support System",
      "description": "Patient’s identified strengths, assets, resilience, and available social/relationship supports."
    },
    {
      "type": "Therapeutic Alliance/Relationship",
      "description": "Quality, rupture/repair cycles, engagement, compliance, feedback, and skill development in the therapy relationship."
    },
    {
      "type": "Treatment/Interventions",
      "description": "Records of CBT interventions, exposures, behavioral experiments, and effectiveness/rationale."
    },
    {
      "type": "Homework/Assignments",
      "description": "Therapy homework and assignments history, adherence, completion, and outcome notes."
    },
    {
      "type": "Skill Acquisition/CBT Competency",
      "description": "Acquisition and mastery of CBT skills and ability for independent use."
    },
    {
      "type": "Activity Patterns/Scheduling",
      "description": "Scheduling of activities, mastery/pleasure ratings, and engagement/avoidance patterns."
    },
    {
      "type": "Mood and Emotional Responses",
      "description": "Patterns of emotional, behavioral, and physiological responses including depression, anxiety, anger, shame, and mood tracking."
    },
    {
      "type": "Triggers",
      "description": "Situational, personal, or environmental triggers for symptoms, moods, and automatic thoughts."
    },
    {
      "type": "Safety Behaviors/Avoidance",
      "description": "Catalogue of specific safety, avoidance, and ritual behaviors, their context and frequency."
    },
    {
      "type": "Episodes/Setbacks/Relapse History",
      "description": "History and details of symptom episodes, relapses, setbacks, warning signs, and preventive strategies."
    },
    {
      "type": "Motivation and Values",
      "description": "Key goals, values, motivation sources, and value-based behavioral patterns."
    },
    {
      "type": "Problem-Solving Capacity",
      "description": "Problem-solving style, skill level, attempts, progress, and responses to setbacks."
    },
    {
      "type": "Personality Features/Traits",
      "description": "Personality disorder features or relevant traits such as obsessiveness, perfectionism, or hostility."
    },
    {
      "type": "Self-Concept/Identity",
      "description": "Self-esteem, shame, self-worth, identity, and related beliefs and changes."
    },
    {
      "type": "Physical Symptoms/Reactions",
      "description": "Typical physical reactions to emotional distress (e.g., agitation, withdrawal, somatic symptoms)."
    },
    {
      "type": "Habits and Lifestyle",
      "description": "Patterns in diet, sleep, exercise, substance use, routines, and self-care."
    },
    {
      "type": "Addiction/Problematic Behaviors",
      "description": "Substance or behavioral addictions and compulsive behaviors."
    },
    {
      "type": "Sleep and Insomnia Features",
      "description": "Sleep patterns, quality, beliefs about sleep, and related behaviors."
    },
    {
      "type": "Eating Disorder and Body Image Features",
      "description": "Disordered eating patterns, compensatory behaviors, body image concerns, and related beliefs."
    },
    {
      "type": "OCD and Compulsive Symptoms",
      "description": "Obsessional problems, compulsions, rituals, and related avoidance."
    },
    {
      "type": "Anger and Rumination Patterns",
      "description": "Antecedents, patterns, and consequences of anger and rumination."
    },
    {
      "type": "Trauma and Abuse History",
      "description": "History, timing, and sequence of trauma, loss, abuse, bullying, neglect, and associated impacts."
    },
    {
      "type": "Support System Involvement",
      "description": "Role/involvement of significant others/family in support, rituals, or symptom maintenance."
    },
    {
      "type": "Therapist’s Observations",
      "description": "Therapist’s observations, notes, reactions, and clinical assumptions about therapy process."
    },
    {
      "type": "Functional Outcomes/Impairment",
      "description": "Functioning and impairment in social, academic, occupational, and daily living domains."
    },
    {
      "type": "Standardized Assessments",
      "description": "Scores and outcomes from standardized assessment and symptom measures over time."
    },
    {
      "type": "Insight/Understanding",
      "description": "Patient’s evolving insight, metacognition, and understanding of therapy and disorder."
    },
    {
      "type": "Transference/Countertransference",
      "description": "Patient transference patterns and therapist’s countertransference reactions."
    }
  ],
