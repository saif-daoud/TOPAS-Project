{
  "nodes": [
    {
      "type": "Patient",
      "description": "Root node representing the individual receiving CBT."
    },
    {
      "type": "Diagnostic History",
      "description": "Comprehensive record of psychiatric diagnoses, comorbidities, and relevant medical conditions."
    },
    {
      "type": "Symptom Profile",
      "description": "Longitudinal data on symptom types, severity, acuity, chronicity, onset, and changes over time."
    },
    {
      "type": "Functional Impairment",
      "description": "Impact of mental health on functioning in social, occupational, educational, and other life domains across time."
    },
    {
      "type": "Treatment Goals and Progress",
      "description": "Identified therapy goals, individual progress, goal achievement status, and relapse prevention efforts."
    },
    {
      "type": "Interventions and Outcomes",
      "description": "Records of completed interventions, exposures, behavioral experiments, and their outcomes (successes, failures, learning)."
    },
    {
      "type": "Medication History",
      "description": "Details of past and current medication regimens, trial responses, side effects, and rationales for changes."
    },
    {
      "type": "Significant Life Events/Stressors",
      "description": "Critical life occurrences (trauma, loss, transitions, stressors) affecting symptoms or therapy."
    },
    {
      "type": "Engagement and Response Pattern",
      "description": "Patient's motivation, engagement levels, resistance, compliance, treatment dropouts, and attitudinal shifts."
    },
    {
      "type": "Episode History",
      "description": "Number, duration, triggers, and outcomes of previous major episodes (e.g., depressive, panic, anxiety)."
    },
    {
      "type": "Family Psychiatric History",
      "description": "Mental health, substance use, and psychiatric history in the patient's family."
    },
    {
      "type": "Core Beliefs/Schemas",
      "description": "Enduring beliefs about self, others, world; schema origin, development, and evolution."
    },
    {
      "type": "Maladaptive Assumptions & Automatic Thoughts",
      "description": "Recurring negative automatic thoughts and unhelpful assumptions affecting functioning."
    },
    {
      "type": "Coping Strategies",
      "description": "Coping methods (adaptive/maladaptive), avoidance, compensation, behavioral/social skills deficits."
    },
    {
      "type": "Relationship History",
      "description": "History of significant past/current relationships, conflicts, social support, and relational/attachment issues."
    },
    {
      "type": "History of Suicidality/Self-harm",
      "description": "Episodes of suicidal ideation, attempts, self-harm, and related safety plans/interventions."
    },
    {
      "type": "Motivational and Behavioral Patterns",
      "description": "Habits, routines, reinforcement mechanisms, reward sources, changes in motivation."
    },
    {
      "type": "Personality Traits",
      "description": "Relevant stable personality characteristics (e.g., obsessiveness, perfectionism) influencing therapy."
    },
    {
      "type": "Cultural/Family/Religious Factors",
      "description": "Contextual factors shaping beliefs, behaviors, and treatment engagement."
    },
    {
      "type": "Panic/Phobia/Avoidance Profile",
      "description": "History and details of panic, phobias, avoidance behaviors, and associated hierarchies."
    },
    {
      "type": "Feared/Avoided Situations & Safety Behaviors",
      "description": "Catalog of feared scenarios, avoided situations, and employed safety behaviors."
    },
    {
      "type": "Exposure Hierarchies & Progress",
      "description": "Exposure items, hierarchy changes, items mastered, and remaining targets."
    },
    {
      "type": "Standardized Assessments",
      "description": "Scores from standardized symptom/behavioral/emotional measures and their evolution."
    },
    {
      "type": "Emotional Schema Features",
      "description": "Patterns of emotional response, emotional validation progress, metacognitive beliefs about emotions."
    },
    {
      "type": "Problem-solving Capacity",
      "description": "Record of problem-solving attempts, skill level, and learning trajectory."
    },
    {
      "type": "Homework and Adherence",
      "description": "History and outcomes of therapy homework, patient compliance, and independent practice."
    },
    {
      "type": "Trauma History",
      "description": "Nature, timing, and sequence of traumatic events experienced by the patient."
    },
    {
      "type": "Triggers and Cognitive Distortions",
      "description": "Key triggers ('hot spots'), cognitive distortions, automatic thoughts, and their change over time."
    },
    {
      "type": "Strengths and Support Structures",
      "description": "Evidence of coping resources, strengths, supportive relationships/networks."
    },
    {
      "type": "Rewarding Activities/Self-rewards",
      "description": "Records of pleasurable, rewarding, or self-reinforcing activities and patient use of self-rewards."
    },
    {
      "type": "Problematic Habits/Compulsive Behaviors",
      "description": "Obsessive themes, compulsive rituals, and detailed patterns of compulsive/avoidant behavior."
    },
    {
      "type": "Family Involvement",
      "description": "Role and involvement of family members in rituals, support, or maintenance of symptoms."
    },
    {
      "type": "Case Conceptualization",
      "description": "Ongoing integrative understanding (developmental, cognitive, behavioral, metacognitive, emotional schema) of the patient."
    },
    {
      "type": "Relapse/Recurrence/Risk Factors",
      "description": "Observed or predicted risk factors for relapse, recurrence patterns, and ongoing risk assessment."
    }
  ],
