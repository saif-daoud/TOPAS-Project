# Local access. In production, remove TOPAS_ACCESS_CODE and set one or more
# comma-separated SHA-256 hashes in TOPAS_ACCESS_CODE_HASHES.
TOPAS_ACCESS_CODE=topas-preview
TOPAS_TOKEN_SECRET=replace-with-a-long-random-secret
TOPAS_DATA_DIR=./data

# Azure AI Foundry / Azure OpenAI compatible endpoint used by simulations/llm.py.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://qcri-sakina.services.ai.azure.com/openai/v1
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Use Windows/macOS/Linux native trust roots (helpful on managed networks).
TOPAS_USE_SYSTEM_CA=true
# TOPAS_CA_BUNDLE=C:\\path\\to\\your-organization-ca.pem

# Optional deployment aliases if the Azure deployment names differ.
TOPAS_MODEL_GPT_5_1=gpt-5.1
TOPAS_MODEL_GPT_4_1=gpt-4.1
TOPAS_MODEL_DEEPSEEK_V4_PRO=DeepSeek-V4-Pro

# Comma-separated frontend origins.
TOPAS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
TOPAS_ENV=development
